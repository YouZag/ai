# Copy to functions/.env and fill in. Firebase reads this at deploy for the
# non-secret function params (secrets live in Secret Manager, set with
# `firebase functions:secrets:set`).
REPO_OWNER=youzag
REPO_NAME=ai
WORK_BRANCH=main

# Optional: comma-separated admin emails allowed to call listModels (defaults to drew@youzag.com)
# ADMIN_EMAILS=drew@youzag.com
