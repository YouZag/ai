# Copy to functions/.env and fill in. Firebase reads this at deploy for the
# non-secret function params (secrets live in Secret Manager, set with
# `firebase functions:secrets:set`).
TASKS_LOCATION=us-central1
TASKS_QUEUE=build-runs
WORKER_URL=https://us-central1-YOUR_PROJECT.cloudfunctions.net/runWorker
TASKS_INVOKER_SA=tasks-invoker@YOUR_PROJECT.iam.gserviceaccount.com
REPO_OWNER=youzag
REPO_NAME=ai
WORK_BRANCH=main
