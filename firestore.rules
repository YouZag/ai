rules_version = '2';

// Default-deny Firestore security rules. Open up access per collection as your
// data model grows. The Admin SDK (Express server + Cloud Functions) bypasses
// these rules, so they only constrain direct client (browser) access.
// Docs: https://firebase.google.com/docs/firestore/security/get-started
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny all client reads/writes by default.
    match /{document=**} {
      allow read, write: if false;
    }

    // Example: let signed-in users read/write only their own user document.
    // match /users/{userId} {
    //   allow read, write: if request.auth != null && request.auth.uid == userId;
    // }
  }
}
