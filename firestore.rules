rules_version = '2';

// The cockpit (browser) reaches Firestore as an authenticated admin; the Admin SDK
// (Cloud Functions + worker) bypasses these rules. Admins author direction
// (vision, features, agents, directives) and read the pipeline; the pipeline
// collections are written only by the server.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['drew@youzag.com'];
    }

    match /vision/{doc} {
      allow read, write: if isAdmin();
    }
    match /features/{doc} {
      allow read, write: if isAdmin();
    }
    match /agents/{doc} {
      allow read, write: if isAdmin();
    }
    match /directives/{doc} {
      allow read, write: if isAdmin();
    }

    match /specs/{doc} {
      allow read: if isAdmin();
    }
    match /steps/{doc} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && resource.data.assignee == 'user'
        && resource.data.status == 'awaiting-user'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['done', 'blocked'];
    }
    match /runs/{doc} {
      allow read: if isAdmin();
    }
    match /architecture/{doc} {
      allow read: if isAdmin();
    }
    match /activity/{doc} {
      allow read: if isAdmin();
    }
    match /metrics/{doc} {
      allow read: if isAdmin();
    }

    match /errors/{doc} {
      allow read, create: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
